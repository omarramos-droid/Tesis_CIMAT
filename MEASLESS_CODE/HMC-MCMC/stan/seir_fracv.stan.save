functions {
  vector seir_rhs(real t, vector Y, real beta_t, real gamma, real kappa, real N) {
    vector[4] dY;
    real S = Y[1]; 
    real E = Y[2]; 
    real I = Y[3];
    
    dY[1] = -beta_t * S * I / N;
    dY[2] =  beta_t * S * I / N - kappa * E;
    dY[3] =  kappa * E - gamma * I;
    dY[4] =  gamma * I;
    return dY;
  }

  matrix solve_fractional_beta_var(real alpha, real beta0, real delta,
                                    real gamma, real kappa,
                                    real N, real I0, real E0, 
                                    int K, real h) {
    real G1 = tgamma(alpha + 1.0);
    real G2 = tgamma(alpha + 2.0);
    real h_alpha = pow(h, alpha);
    
    matrix[K + 1, 4] y;
    array[K + 1] vector[4] f_vals;
    
    // Condiciones iniciales
    y[1, 1] = N - I0 - E0;
    y[1, 2] = E0;
    y[1, 3] = I0;
    y[1, 4] = 0.0;
    
    // beta en t=0
    real beta_t0 = beta0;
    f_vals[1] = seir_rhs(0.0, to_vector(y[1]), beta_t0, gamma, kappa, N);
    
    for (n in 2:(K + 1)) {
      // Tiempo actual
      real t_current = (n - 1) * h;
      
      // Calcular beta en el tiempo actual: beta(t) = beta0 * exp(-delta * t)
      real beta_current = beta0 * exp(-delta * t_current);
      
      // Predictor
      vector[4] sum_pred = rep_vector(0.0, 4);
      for (j in 1:(n - 1)) {
        real b = pow(n - j * 1.0, alpha) - pow(n - j - 1.0, alpha);
        sum_pred += b * f_vals[j];
      }
      vector[4] y_pred = to_vector(y[1]) + (h_alpha / G1) * sum_pred;
      
      // Proyección de positividad y conservación de N
      for (k in 1:4) y_pred[k] = fmax(y_pred[k], 0.0);
      real total = sum(y_pred);
      total = fmax(total, 1e-12);
      y_pred = y_pred * (N / total);
      
      // Evaluar rhs con beta actual
      vector[4] f_pred = seir_rhs(t_current, y_pred, beta_current, gamma, kappa, N);
      
      // Corrector
      vector[4] sum_corr = rep_vector(0.0, 4);
      real a0 = pow(n - 2.0, alpha + 1.0) - (n - 2.0 - alpha) * pow(n - 1.0, alpha);
      sum_corr += a0 * f_vals[1];
      
      for (j in 2:(n - 1)) {
        real a = pow(n - j + 1.0, alpha + 1.0) 
                 - 2.0 * pow(n - j * 1.0, alpha + 1.0) 
                 + pow(n - j - 1.0, alpha + 1.0);
        sum_corr += a * f_vals[j];
      }
      
      vector[4] y_corr = to_vector(y[1]) + (h_alpha / G2) * (sum_corr + f_pred);
      
      // Proyección de positividad en la corrección
      for (k in 1:4) y_corr[k] = fmax(y_corr[k], 0.0);
      total = sum(y_corr);
      total = fmax(total, 1e-12);
      y_corr = y_corr * (N / total);
      
      y[n] = to_row_vector(y_corr);
      f_vals[n] = seir_rhs(t_current, y_corr, beta_current, gamma, kappa, N);
    }
    return y;
  }
}

data {
  int<lower=1> T;
  array[T] int<lower=0> y;
  real<lower=0> N0;
  real<lower=0> h;
}

transformed data {
  int steps_per_week = to_int(round(1.0 / h));
  int K = T * steps_per_week;
  real h_solver = 1.0 / steps_per_week;
}

parameters {
  real log_beta0;        // log(beta inicial) - LogNormal
  real log_delta;        // log(tasa de decaimiento) - LogNormal
  real log_I0;           // log(infectados iniciales) - LogNormal
  real log_p;            // log(probabilidad de detección) - LogNormal
  real log_theta;        // log(dispersión) - LogNormal
  real<lower=0, upper=1> alpha;  // Beta  para alpha
  real<lower=0> gamma;   // LogNormal 
  real<lower=0> kappa;   // LogNormal 
}

transformed parameters {
  real beta0 = exp(log_beta0);
  real delta = exp(log_delta);
  real I0    = exp(log_I0);
  real p     = exp(log_p);
  real theta = exp(log_theta);
  
  // Calcular beta(t) para cada semana (para diagnóstico)
  array[T] real beta_week;
  for (t in 1:T) {
    real t_week = (t - 1) * 1.0;  // tiempo en semanas
    beta_week[t] = beta0 * exp(-delta * t_week);
  }
  
  // Resolver el sistema con beta variable
  matrix[K + 1, 4] sol_fine =
      solve_fractional_beta_var(
          alpha,
          beta0,
          delta,
          gamma,
          kappa,
          N0,
          I0,
          0.0,
          K,
          h_solver);

  array[T] real incidence;
  array[T] real mu;

  for (t in 1:T) {
    int left  = (t - 1) * steps_per_week + 1;
    int right = t * steps_per_week + 1;
    real diff = sol_fine[left, 1] - sol_fine[right, 1];
    
    incidence[t] = fmax(diff, 1e-6);
    mu[t] = p * incidence[t];
  }
}

model {
  // Priors lognormales para parámetros positivos
  log_beta0 ~ normal(log(2.0), 0.5);   // beta0 ~ LogNormal(log(2.0), 0.5)
  log_delta ~ normal(log(0.09), 0.5);  // delta ~ LogNormal(log(0.09), 0.5)
  log_I0 ~ normal(log(100), 1);        // I0 ~ LogNormal(log(100), 1)
  log_p ~ normal(log(0.5), 0.5);       // p ~ LogNormal(log(0.5), 0.5)
  log_theta ~ normal(log(16), 0.5);    // theta ~ LogNormal(log(16), 0.5)
  
  // Prior Beta para alpha
  alpha ~ beta(1,1);  // Distribución Beta uniforme
  // Priors lognormales para gamma y kappa 
  gamma ~ lognormal(log(0.875), 0.05);  // gamma ~ LogNormal(log(0.875), 0.05)
  kappa ~ lognormal(log(0.5), 0.05);    // kappa ~ LogNormal(log(0.5), 0.05)
  
  // Likelihood
  for (t in 1:T)
    y[t] ~ neg_binomial_2(mu[t], theta);
}

generated quantities {
  real beta0_gq = exp(log_beta0);
  real delta_gq = exp(log_delta);
  
  // R0 efectivo inicial
  real R0_initial = beta0_gq / gamma;
  
  // R0 efectivo al final del período
  real R0_final = beta0_gq * exp(-delta_gq * (T - 1)) / gamma;
  
  // Beta promedio durante el brote
  real beta_mean = beta0_gq * (1 - exp(-delta_gq * T)) / (delta_gq * T);
  
  // Predictivas
  array[T] int y_rep;
  for (t in 1:T)
    y_rep[t] = neg_binomial_2_rng(mu[t], theta);
}
